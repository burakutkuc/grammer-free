{
  "manifest_version": 3,
  "name": "GrammarFree",
  "description": "Free real-time grammar, spelling, and punctuation checker powered by LanguageTool.",
  "version": "0.1.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://api.languagetool.org/*",
    "https://api.languagetoolplus.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "GrammarFree",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "docs/icon/icon-16.png",
      "48": "docs/icon/icon-48.png",
      "128": "docs/icon/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "docs/icon/icon-16.png",
    "48": "docs/icon/icon-48.png",
    "128": "docs/icon/icon-128.png"
  }
}
